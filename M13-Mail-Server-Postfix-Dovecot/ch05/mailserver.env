# ~/dms/mailserver.env  เฉพาะค่าที่เปลี่ยนจากค่าเริ่มต้น
SSL_TYPE=manual
SSL_CERT_PATH=/tmp/docker-mailserver/ssl/cert.pem
SSL_KEY_PATH=/tmp/docker-mailserver/ssl/key.pem
ENABLE_CLAMAV=0
ENABLE_RSPAMD=1
ENABLE_OPENDKIM=0
ENABLE_OPENDMARC=0
ENABLE_POLICYD_SPF=0
ENABLE_AMAVIS=0
ENABLE_SPAMASSASSIN=0
ENABLE_FAIL2BAN=0
POSTMASTER_ADDRESS=admin@example.net

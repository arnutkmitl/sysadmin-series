{
 "uid": "backup-health",
 "title": "Backup Health (M17)",
 "timezone": "browser",
 "schemaVersion": 41,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "สถานะรอบล่าสุด",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 5
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "targets": [
    {
     "refId": "A",
     "expr": "backup_last_status",
     "legendFormat": "{{task}}",
     "instant": true
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value_and_name",
    "orientation": "horizontal"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "สำเร็จ",
         "color": "green"
        },
        "1": {
         "text": "ล้มเหลว",
         "color": "red"
        }
       }
      }
     ]
    },
    "overrides": []
   }
  },
  {
   "id": 2,
   "type": "stat",

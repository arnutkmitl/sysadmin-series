[Unit]
Description=SeaweedFS single node (master + volume + filer + S3)
After=network-online.target
Wants=network-online.target

[Service]
User=seaweed
Group=seaweed
# -s3.config คือรายชื่อผู้ใช้และสิทธิ์ของ S3 ที่ไฟล์ /etc/seaweedfs/s3.json
ExecStart=/usr/local/bin/weed server -dir=/srv/backup/seaweed -ip=192.168.56.86 \
          -volume.max=0 -master.volumeSizeLimitMB=1024 \
          -filer -s3 -s3.port=8333 -s3.config=/etc/seaweedfs/s3.json
Restart=on-failure
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target

{# /home/admin/ansible-lab/playbooks/ready/templates/m15-tls.conf.j2 #}
# {{ ansible_managed }}
server {
    listen 443 ssl;
    http2 on;
    server_name {{ tls_name }};
    ssl_certificate     /etc/pki/tls/certs/{{ tls_name }}.crt;
    ssl_certificate_key /etc/pki/tls/private/{{ tls_name }}.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    root {{ nginx_root }}/m15;
    index index.html;
    charset utf-8;
}

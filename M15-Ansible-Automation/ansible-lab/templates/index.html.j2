{# /home/admin/ansible-lab/templates/index.html.j2 #}
<!doctype html>
<meta charset="utf-8">
<title>{{ site_title }}</title>
<style>body{font-family:sans-serif;margin:2em}h1{color:{{ site_color }}}</style>
<h1>{{ site_title }}</h1>
<p>เครื่อง {{ inventory_hostname }} ({{ ansible_host }}) ใช้ {{ ansible_distribution }} {{ ansible_distribution_version }}
   หน่วยความจำ {{ ansible_memtotal_mb }} MB</p>
<p>เครื่องมือที่ติดตั้ง:</p>
<ul>
{% for t in tools %}
  <li>{{ t }}</li>
{% endfor %}
</ul>
<p>ดูแลโดย {{ site_owner }}</p>
